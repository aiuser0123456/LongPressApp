<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="28dp"  android:paddingBottom="28dp">

        <TextView android:id="@+id/tvTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LONG PRESS BOT"
            android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"
            android:letterSpacing="0.15" android:fontFamily="monospace"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Continuous gesture simulator"
            android:textColor="#666666" android:textSize="12sp" android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Status Card -->
        <androidx.cardview.widget.CardView android:id="@+id/cardStatus"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1E1E1E" app:cardCornerRadius="14dp" app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:id="@+id/tvStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="● Status: Idle" android:textColor="#888888"
                    android:textSize="13sp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚠ Accessibility Service: Disabled" android:textColor="#FF9800"
                    android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="6dp"/>
                <TextView android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⚠ Overlay Permission: Not Granted" android:textColor="#FF9800"
                    android:textSize="12sp" android:fontFamily="monospace" android:layout_marginTop="4dp"/>
                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#2A2A2A" android:layout_marginTop="12dp" android:layout_marginBottom="10dp"/>
                <TextView android:id="@+id/tvTouchPosition"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Touch: X 50.0% / Y 50.0%" android:textColor="#AAAAAA"
                    android:textSize="12sp" android:fontFamily="monospace"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Timing Card -->
        <androidx.cardview.widget.CardView android:id="@+id/cardSettings"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E1E1E" app:cardCornerRadius="14dp" app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/cardStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TIMING" android:textColor="#444444" android:textSize="10sp"
                    android:letterSpacing="0.15" android:fontFamily="monospace"/>

                <TextView android:id="@+id/tvHoldDuration"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hold Duration: 500 ms" android:textColor="#CCCCCC"
                    android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="14dp"/>
                <SeekBar android:id="@+id/seekHoldDuration"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="4500" android:progress="450"
                    android:progressTint="#6200EE" android:thumbTint="#BB86FC" android:layout_marginTop="6dp"/>

                <TextView android:id="@+id/tvTapInterval"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Repeat Interval: 200 ms" android:textColor="#CCCCCC"
                    android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="18dp"/>
                <SeekBar android:id="@+id/seekTapInterval"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="2950" android:progress="150"
                    android:progressTint="#6200EE" android:thumbTint="#BB86FC" android:layout_marginTop="6dp"/>

                <TextView android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Start Delay: 3s" android:textColor="#CCCCCC"
                    android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="18dp"/>
                <SeekBar android:id="@+id/seekCountdown"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:max="10" android:progress="3"
                    android:progressTint="#FF9800" android:thumbTint="#FFB74D" android:layout_marginTop="6dp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#2A2A2A" android:layout_marginTop="16dp" android:layout_marginBottom="10dp"/>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="➊ Tap SHOW OVERLAY — app minimizes\n➋ Open your game\n➌ Drag ⊕ dot to tap position\n➍ Tap ▶ START on the floating panel\n➎ Tap ⚙ for quick settings\n➏ Tap – to hide panel (tap purple dot to restore)\n➐ Tap ⊗ EXIT to close everything"
                    android:textColor="#555555" android:textSize="11sp"
                    android:fontFamily="monospace" android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Setup Card -->
        <androidx.cardview.widget.CardView android:id="@+id/cardPermissions"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#1E1E1E" app:cardCornerRadius="14dp" app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/cardSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SETUP" android:textColor="#444444" android:textSize="10sp"
                    android:letterSpacing="0.15" android:fontFamily="monospace"/>
                <Button android:id="@+id/btnGrantOverlay"
                    android:layout_width="match_parent" android:layout_height="46dp"
                    android:text="Grant Overlay Permission" android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#6200EE"/>
                <Button android:id="@+id/btnEnableAccessibility"
                    android:layout_width="match_parent" android:layout_height="46dp"
                    android:text="Enable Accessibility Service" android:textColor="#FFFFFF"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="#6200EE"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Main button -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btnToggle"
            android:layout_width="0dp" android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="SHOW OVERLAY"
            android:textSize="17sp" android:textStyle="bold"
            android:letterSpacing="0.1" android:fontFamily="monospace" android:textColor="#FFFFFF"
            app:backgroundTint="#6200EE" app:cornerRadius="14dp"
            app:layout_constraintTop_toBottomOf="@id/cardPermissions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
